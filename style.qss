    QWidget#mainWindow {
  background-color: qlineargradient(x1:0, y1:0, x2:1, y2:1, stop:0 #f7fbff, stop:1 #e6f0ff);
  color: #222222;
  font-family: "Comic Sans MS", "Segoe UI", sans-serif;
  font-size: 14px;
  padding: 12px;
}

/* Image labels that sit in the grid */
QLabel#characterImageLabel, QLabel#seriesImageLabel {
  background: white;
  border: 1px solid #d0d7df;
  border-radius: 8px;
  padding: 6px;
}
