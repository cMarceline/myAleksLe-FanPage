QWidget#mainWindow {
  background-color: qlineargradient(x1:0, y1:0, x2:1, y2:1, stop:0 #aed7ff, stop:1 #0066ff);
  color: #222222;
  font-family: "Comic Sans MS", "Segoe UI", sans-serif;
  font-size: 14px;
  padding: 12px;
}

QLabel{
    font: Comic Sans MS
}

/* Image labels that sit in the grid */
QLabel#aleksLeImage {
  background: white;
  border: 1px solid #0077ff;
  border-radius: 8px;
  padding: 6px;
  min-height: 100px;
}

QTableWidget {
    width: 100%;
    background: #7aaeea;
}
